# Supabase — get from supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Storage bucket name — must match what you create in Supabase Storage
SUPABASE_STORAGE_BUCKET=certificates

# Admin auth
# ADMIN_PASSWORD: the single password every admin will use
# SESSION_SECRET: random hex used to sign the session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_PASSWORD=
SESSION_SECRET=

# Public base URL (used in deep-links shown to admins after generation)
# Set to your Vercel URL in production, e.g., https://result.undertheree.org
PUBLIC_BASE_URL=http://localhost:3000

# Academic year override (optional). If unset, derived from current date:
#   Apr–Jun → previous calendar year
#   Jul–Mar → current calendar year
# ACADEMIC_YEAR=2025
